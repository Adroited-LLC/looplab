{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "/home/**"
        },
        {
          "path": "/run/media/**"
        },
        {
          "path": "/mnt/**"
        }
      ]
    },
    "store:default",
    "store:allow-load",
    "store:allow-set",
    "store:allow-get",
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}
